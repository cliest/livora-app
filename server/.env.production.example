# Copy to server/.env on the VPS and fill in real values. Never commit the
# real .env — it's already gitignored.

# --- Database ---------------------------------------------------------
# If Postgres runs on the same VPS: postgresql://user:pass@localhost:5432/livora
# If using a managed Postgres instead, use the connection string it gives you.
DATABASE_URL="postgresql://livora:CHANGE_ME@localhost:5432/livora?schema=public"

PORT=4000

# --- Security -----------------------------------------------------------
# REQUIRED. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Without this, sessions fall back to a hardcoded dev value readable in
# source control — do not deploy without setting this.
JWT_SECRET="CHANGE_ME"

# Flips the admin auth cookie to Secure (HTTPS-only). Set this once the site
# is actually served over HTTPS (i.e. after certbot), not before.
NODE_ENV=production

# Same-origin architecture (see deploy/nginx.conf) means the browser never
# makes a cross-origin request to the API, so this mostly matters as
# defense-in-depth rather than something that blocks real traffic.
CLIENT_ORIGIN="https://livoradentalclinic.com"

# --- Notifications --------------------------------------------------------
CLINIC_NOTIFY_EMAIL="info@livoradentalclinic.com"

# Leave blank to keep booking/contact notifications logging to console
# instead of emailing (submissions still save to Postgres either way).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- First admin login (only used by `node prisma/seed.js`) ---------------
# Set these before running the seed script on the VPS, so the real admin
# account is created with a strong password from the start instead of the
# repo's default. Unset these two afterwards; they're not read at runtime.
SEED_ADMIN_EMAIL="admin@livoradentalclinic.com"
SEED_ADMIN_PASSWORD="CHANGE_ME"
