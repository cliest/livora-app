// Livora Dental Clinic — Prisma schema
// Mirrors the two forms from the original build: the booking request form
// (book.html) and the general contact form (contact.html).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PreferredTime {
  MORNING   // 07:00–12:00
  AFTERNOON // 12:00–17:00
  EVENING   // 17:00–22:00
  OVERNIGHT // 22:00–07:00
}

enum NhimaStatus {
  YES
  NO
  UNSURE
}

enum PatientType {
  NEW
  RETURNING
}

enum RequestStatus {
  PENDING     // just submitted, nobody has actioned it yet
  CONFIRMED   // clinic called back and locked in a time
  CANCELLED
  COMPLETED
}

enum ServiceType {
  EMERGENCY
  CHECKUP
  FILLING
  ROOT_CANAL
  CROWN_BRIDGE
  EXTRACTION
  IMPLANT
  BRACES
  WHITENING
  CHILDREN
  DENTURE
  OTHER
}

enum ContactSubject {
  APPOINTMENT
  TREATMENT
  PRICES
  NHIMA
  RECORDS
  FEEDBACK
  OTHER
}

model BookingRequest {
  id             String         @id @default(cuid())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  fullName       String
  phone          String
  email          String?

  patientType    PatientType?
  service        ServiceType
  preferredDate  DateTime       @db.Date
  preferredTime  PreferredTime  @default(MORNING)
  nhimaMember    NhimaStatus

  message        String?

  consentGiven   Boolean        @default(false)

  status         RequestStatus  @default(PENDING)
  staffNotes     String?

  // basic anti-spam / audit trail, never shown to the clinic
  ipAddress      String?
  userAgent      String?

  @@index([status, preferredDate])
  @@index([createdAt])
  @@map("booking_requests")
}

model ContactMessage {
  id           String         @id @default(cuid())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  fullName     String
  email        String
  phone        String?
  subject      ContactSubject
  message      String

  consentGiven Boolean        @default(false)

  status       RequestStatus  @default(PENDING)
  staffNotes   String?

  ipAddress    String?
  userAgent    String?

  @@index([status, createdAt])
  @@map("contact_messages")
}

// Single row holding the clinic's admin credentials for the bookings
// dashboard. Kept as its own model rather than hardcoding a login so the
// password can be rotated without a redeploy.
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?

  @@map("admin_users")
}

// Singleton row (fixed id) holding the site-wide contact details every
// public page currently hardcodes — edited from the admin dashboard.
model SiteSettings {
  id           String   @id @default("settings")
  phoneDisplay String   @default("+260 76 073 7805")
  phoneDial    String   @default("+260760737805") // digits used in tel:/wa.me links
  email        String   @default("info@livoradentalclinic.com")
  addressLine1 String   @default("Plot 00, Street Name")
  addressLine2 String   @default("Lusaka, Zambia")
  facebookUrl  String?
  instagramUrl String?
  tiktokUrl    String?
  updatedAt    DateTime @updatedAt

  @@map("site_settings")
}

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  role        String
  bio         String
  credentials String
  photoUrl    String?
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, sortOrder])
  @@map("team_members")
}

model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  name      String
  role      String
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
  @@map("testimonials")
}

enum PriceCategoryIcon {
  SHIELD
  TOOTH
  SPARKLE
  BRACES
  CROWN
  BOLT
}

model PriceCategory {
  id        String            @id @default(cuid())
  title     String
  icon      PriceCategoryIcon
  note      String?
  sortOrder Int               @default(0)
  items     PriceItem[]

  @@map("price_categories")
}

model PriceItem {
  id          String        @id @default(cuid())
  categoryId  String
  category    PriceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  price       String
  isPopular   Boolean       @default(false)
  isEmergency Boolean       @default(false)
  sortOrder   Int           @default(0)

  @@index([categoryId])
  @@map("price_items")
}

// Registration/accreditation badges shown on the About page — admin
// uploads the certificate image, same upload endpoint as team photos.
model Accreditation {
  id        String   @id @default(cuid())
  title     String
  badgeUrl  String?
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
  @@map("accreditations")
}
