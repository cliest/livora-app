# systemd unit for the Express API. Install:
#   sudo cp deploy/livora-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now livora-api
#
# Adjust User/WorkingDirectory if the repo isn't at /var/www/livora-app or
# the deploy user isn't called `livora` (see deploy/SETUP.md for creating it).

[Unit]
Description=Livora Dental Clinic API
After=network.target postgresql.service

[Service]
Type=simple
User=livora
Group=livora
WorkingDirectory=/var/www/livora-app/server
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=5
EnvironmentFile=/var/www/livora-app/server/.env

# Basic hardening — the API only needs to read its own directory, write to
# uploads/, and talk to the network and the database.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/livora-app/server/uploads

[Install]
WantedBy=multi-user.target
